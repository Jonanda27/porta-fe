# PostgreSQL Database (PORTA)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/porta_db?schema=public"

# Redis (BullMQ & Cache)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# API Server
PORT=4000
NODE_ENV="development"
JWT_SECRET="porta_super_secret_jwt_key_development_only"

# Web Dashboard (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Mobile (Expo)
EXPO_PUBLIC_API_URL="http://localhost:4000"
